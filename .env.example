# Optional: encryption key used to encrypt saved connection passwords at rest.
# If unset, a key is generated on first run and stored in data/secret.key.
APP_SECRET=

# Optional: directory for app metadata (connections store + secret key).
# Defaults to ./data
DATA_DIR=

# Optional: disable anonymous usage analytics (Microsoft Clarity).
# Set to 1 to opt out. See README > Telemetry.
NEXT_PUBLIC_DISABLE_TELEMETRY=

# Optional: point analytics at your own Microsoft Clarity project instead of
# the shared Overlook OSS dashboard.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
