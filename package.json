{
  "name": "overlook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "test:db": "docker compose up -d postgres-dev mysql-dev && OVERLOOK_TEST_POSTGRES=postgres://overlook:overlook@127.0.0.1:5433/overlook_dev OVERLOOK_TEST_MYSQL=mysql://overlook:overlook@127.0.0.1:3307/overlook_dev vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "mysql2": "^3.24.2",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2": "^1.15.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
